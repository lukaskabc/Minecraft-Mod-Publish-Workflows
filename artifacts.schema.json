{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "artifacts"
  ],
  "properties": {
    "artifacts": {
      "type": "array",
      "description": "Configuration for artifacts that should be released",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "branch": {
            "type": "string",
            "description": "The name of the branch from which the artifact is compiled"
          },
          "loaders": {
            "type": "array",
            "description": "Mod loaders that can load the artifact (neoforge, forge, fabric)",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "neoforge",
                "fabric",
                "forge"
              ]
            },
            "uniqueItems": true
          },
          "game_versions": {
            "type": "array",
            "description": "Supported game versions for the artifact",
            "minItems": 1,
            "items": {
              "pattern": "^\\d+(\\.\\d+)+$",
              "type": "string"
            },
            "uniqueItems": true
          },
          "java_version": {
            "type": "string",
            "description": "The java version used to run the gradle build task"
          },
          "version_properties": {
            "type": "array",
            "description": "List of files and respective properties where the version should be set (default: mod_version in gradle.properties)",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "description": "The relative path to the file"
                },
                "property": {
                  "type": "string",
                  "description": "The name of the property which should be set to the version"
                }
              },
              "required": [
                "file",
                "property"
              ],
              "additionalProperties": false
            }
          },
          "dependencies": {
            "type": "object",
            "description": "Dependencies for the artifact (merged with common dependencies)",
            "$ref": "#/$defs/dependencies"
          }
        },
        "additionalProperties": false,
        "required": [
          "branch",
          "loaders",
          "game_versions",
          "java_version"
        ]
      },
      "uniqueItems": true
    },
    "common_dependencies": {
      "type": "object",
      "description": "Common dependencies for each artifact",
      "$ref": "#/$defs/dependencies"
    }
  },
  "$defs": {
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "curseforge": {
          "type": "array",
          "description": "Dependencies for Curseforge deployment",
          "items": {
            "$ref": "#/$defs/cf_dependency"
          }
        },
        "modrinth": {
          "type": "array",
          "description": "Common dependencies for all artifacts on Curseforge",
          "items": {
            "$ref": "#/$defs/mr_dependency"
          }
        }
      }
    },
    "dependency_type": {
      "type": "string",
      "description": "Type of the dependency",
      "enum": [
        "required",
        "optional",
        "incompatible",
        "embeds"
      ]
    },
    "cf_dependency": {
      "type": "object",
      "description": "Dependency for curseforge",
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "description": "Curseforge project slug"
        },
        "dependency_type": {
          "type": "string",
          "$ref": "#/$defs/dependency_type"
        }
      },
      "required": [
        "slug",
        "dependency_type"
      ]
    },
    "mr_dependency": {
      "type": "object",
      "description": "Dependency for Modrinth",
      "additionalProperties": false,
      "properties": {
        "dependency_type": {
          "type": "string",
          "$ref": "#/$defs/dependency_type"
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "number",
              "description": "ID of the modrinth project"
            }
          },
          "required": ["id"]
        },
        {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "description": "Slug of the modrinth project"
            }
          },
          "required": ["slug"]
        }
      ]
    },
    "required": [
      "identifier",
      "dependency_type"
    ]
  }
}